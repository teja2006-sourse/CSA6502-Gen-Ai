from openai import OpenAI

client = OpenAI(api_key="YOUR_API_KEY")

print("GENERATIVE AI FUNCTIONAL PROMPT LAB")
print("1. Summarization")
print("2. Email Creation")
print("3. Content Generation")

choice = input("Enter your choice (1/2/3): ")

user_input = input("\nEnter your content/topic: ")

if choice == "1":

    prompt = f"""
    Summarize the following text in 5 simple bullet points.
    Use easy-to-understand language.

    Text:
    {user_input}
    """

elif choice == "2":

    prompt = f"""
    Write a professional email based on the following information.
    Include a suitable subject and polite body.

    Information:
    {user_input}
    """

elif choice == "3":

    prompt = f"""
    Generate informative content about the following topic.
    Include an introduction, main points, and conclusion.
    Keep the language simple.

    Topic:
    {user_input}
    """

else:
    print("Invalid choice.")
    exit()

response = client.responses.create(
    model="gpt-5.6",
    input=prompt
)

print("\nGENERATED RESPONSE")
print("==========================")
print(response.output_text)
